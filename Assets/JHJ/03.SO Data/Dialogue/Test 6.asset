  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62ad28c5ec815b24280c09a2856ba125, type: 3}
  m_Name: Test 6
  m_EditorClassIdentifier: Assembly-CSharp::JHJ.Scripts.Interaction.Dialogue.DialogueDataSO
  lines:
  - speakerName: "\uB9C8\uB9AC"
    line: "...\uC5EC\uAE30\uB2E4."
  - speakerName: "\uBA5C\uB9AC\uC2A4"
    line: "(\uBB18\uC9C0\uB97C \uAC00\uB9AC\uD0A4\uBA70) ...\uC774\uAC70 \uC5C4\uB9C8
      \uC774\uB984\uC774\uB791 \uB611\uAC19\uC544\uC694."
  - speakerName: "\uB9C8\uB9AC"
    line: "\uC65C \uC5EC\uAE30 \uC5C4\uB9C8 \uC774\uB984\uC774 \uC788\uC5B4\uC694?
      \uC5C4\uB9C8 \uC774\uB7F0\uAC70 \uC548 \uC88B\uC544\uD558\uB294\uB370."
  - speakerName: "\uBA5C\uB9AC\uC2A4"
    line: "(\uBA5C\uB9AC\uC2A4 \uC606\uC5D0 \uBB34\uB98E\uC744 \uAFC7\uC73C\uBA70,
      \uC870\uC2EC\uC2A4\uB7FD\uAC8C) ...\uBA5C\uB9AC\uC2A4. \uC5EC\uAE30\uB294...
      \uC0AC\uB78C\uB4E4\uC774 \uC7A0\uB4DC\uB294 \uACF3\uC774\uC57C."
  - speakerName: "\uB9C8\uB9AC"
    line: "\uC7A0\uB4E4\uC5B4\uC694? \uADF8\uB7FC \uC5C4\uB9C8 \uC5EC\uAE30\uC11C
      \uC790\uC694?"
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uC7A0\uC2DC \uB9D0\uC744 \uACE0\uB974\uB2E4) ...\uADF8\uB798. \uC544\uC8FC
      \uC624\uB798... \uC544\uC8FC \uC624\uB798 \uC790\uB294 \uAC70\uC57C. \uC774\uC81C
      \uBABB \uC77C\uC5B4\uB098\uB294 \uC7A0."
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uACE0\uAC1C\uB97C \uAC38\uC6C3) ...\uADF8\uB7FC \uAE68\uC6B0\uBA74 \uB418\uC796\uC544\uC694.
      \uC81C\uAC00 \uB9E8\uB0A0 \uAE68\uC6CC\uC92C\uB294\uB370."
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uBAA9\uC774 \uBA54\uC5B4 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD55C\uB2E4)"
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uBB18\uC9C0 \uC55E\uC5D0 \uCABC\uADF8\uB824 \uC549\uC544 \uD759\uC744
      \uB9CC\uC9C0\uBA70) \uC5C4\uB9C8. \uB098 \uC654\uC5B4. \uC77C\uC5B4\uB098."
  - speakerName: "\uB9C8\uB9AC"
    line: "...\uC5C4\uB9C8?"
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uC870\uAE08\uC529 \uBAA9\uC18C\uB9AC\uAC00 \uC791\uC544\uC9C0\uBA70)
      ...\uC65C \uB300\uB2F5 \uC548 \uD574..."
  - speakerName: "\uB9C8\uB9AC"
    line: "\uC65C\uC694."
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uC228\uC744 \uACE0\uB974\uACE0, \uACA8\uC6B0) ...\uC5C4\uB9C8\uB294...
      \uB2E4\uC2DC \uBABB \uC640."
  - speakerName: "\uB9C8\uB9AC"
    line: " ...\uC548 \uC640\uC694? \uC9C4\uC9DC\uB85C?"
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4)"
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uB208\uC5D0 \uB208\uBB3C\uC774 \uCC28\uC624\uB974\uC9C0\uB9CC, \uC544\uC9C1
      \uC18C\uB9AC \uB0B4\uC5B4 \uC6B8\uC9C0\uB294 \uC54A\uB294\uB2E4) ...\uC544\uBE60\uB3C4...
      \uC544\uBE60\uB3C4 \uC548 \uC640\uC694?"
  - speakerName: "\uB9C8\uB9AC"
    line: ..
  - speakerName: "\uB9C8\uB9AC"
    line: "(\uC791\uAC8C, \uB5A8\uB9AC\uB294 \uBAA9\uC18C\uB9AC\uB85C) ...\uC5C4\uB9C8\uC544..."
  - speakerName: "\uB9C8\uB9AC"
    line: "\uC544\uBE60... \uB3CC\uC544\uC628\uB2E4\uACE0 \uD558\uC168\uB294\uB370...\uC65C.."
